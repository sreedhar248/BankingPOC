# Copy this file to .env and fill in your key (get one at console.anthropic.com).
# .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=

# Optional: override the default model (claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5

# Optional: point at a real MongoDB instance instead of the in-memory mongomock
# MONGODB_URI=
