# Copy this file to .env and fill in your key (get one at console.anthropic.com).
# .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=

# Optional: override the default model (claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5

# Optional: point at a real MongoDB instance instead of the in-memory mongomock
# MONGODB_URI=

# Optional: AI gateway limits (defaults: 10 requests/min, 20000 tokens/min)
# GATEWAY_RPM=10
# GATEWAY_TPM=20000

# Optional: Langfuse tracing. Tracing is off unless all three are set.
# Use the BASE_URL of the region your project was created in:
#   EU https://cloud.langfuse.com   US https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# API (Session 7): clients must send one of these as the X-API-Key header.
# Comma-separated. Empty means every request is rejected.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Optional: when the AI gateway throttles a call, return 429 + Retry-After
# instead of the deterministic fallback alert (default: true = fall back)
# THROTTLE_FALLBACK=false

# Optional: with MONGODB_URI set, load the demo data into an EMPTY collection
# SEED_DEMO_DATA=true
